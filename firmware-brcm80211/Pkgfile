# Description: Proprietary Broadcom WiFi Firmware for RPI devices
# URL: https://raspberrypi.org
# Maintainer: mac-a-r0ni, j at lngn dot net
# Depends on:

name=firmware-brcm80211
version=20241210-1
release=2
source=(https://archive.raspberrypi.org/debian/pool/main/f/firmware-nonfree/${name}_${version}+rpt${release}_all.deb)

build() {

ar x ${name}_${version}+rpt${release}_all.deb data.tar.gz
tar xf data.tar.gz
rm data.tar.gz

cd $SRC/usr
mv lib ../
rm -r $SRC/usr
cd ..
rm *.deb
cp -r . $PKG

}
