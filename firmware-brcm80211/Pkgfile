# Description: Proprietary Broadcom WiFi Firmware for RPI devices
# URL: https://raspberrypi.org
# Maintainer: Jay Lanagan, j at lngn dot net
# Depends on:

name=firmware-brcm80211
version=20240709
release=3
source=(https://archive.raspberrypi.org/debian/pool/main/f/firmware-nonfree/${name}_${version}-2~bpo12+1+rpt${release}_all.deb)

build() {

ar x ${name}_${version}-2~bpo12+1+rpt${release}_all.deb data.tar.xz
tar xf data.tar.xz
rm data.tar.xz

rm -r $SRC/usr
mkdir -p $PKG/etc
mv $SRC/lib/modprobe.d $PKG/etc
rm *.deb
cp -r . $PKG

}
